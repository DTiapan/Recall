# ==============================================================================
# Recall - Turnkey Enterprise RAG Configuration Template
# Copy this file to .env and configure for your environment
# ==============================================================================

# Operation Mode: 'local' (100% air-gapped CPU/Ollama) or 'cloud' (OpenAI/Anthropic/Gemini)
RAG_MODE=local
RAG_ENV=production
LOG_LEVEL=INFO

# OpenTelemetry (optional — leave OTLP endpoint blank to keep traces in-process only)
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=recall-kit
OTEL_EXPORTER_OTLP_ENDPOINT=

# Networking & Ports
API_HOST=0.0.0.0
API_PORT=8000
WEB_UI_PORT=8000

# Optional API Security Key (leave blank for open access)
RAG_API_KEY=

# Vector Database (Qdrant)
# For local in-memory: leave blank or set to :memory:
# For local Docker: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Local Mode LLM Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Cloud Mode LLM Providers (Required only if RAG_MODE=cloud)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
